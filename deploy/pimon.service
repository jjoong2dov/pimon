# pimon: 라즈베리 파이 상태 모니터 (docs/plan.md 6절)
#
# 설치 위치 가정: 코드는 /opt/pimon (그 아래 pimon/ 패키지), 설정은 /etc/pimon/pimon.toml.
#   /opt/pimon/pimon/__main__.py 가 있어야 한다. WorkingDirectory 로 python3 -m pimon 이 찾게 한다.
# 배포(복사·daemon-reload·enable)는 사람이 확인한 뒤에 한다.

[Unit]
Description=pimon Raspberry Pi status monitor
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pimon
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m pimon --config /etc/pimon/pimon.toml
# 정상 종료 뒤에도, 강제 종료(SIGKILL·OOM·예외로 죽음) 뒤에도 불린다.
# 기록(/run/pimon/led.json)이 없으면 아무것도 하지 않고 0 으로 끝난다.
# 정상 종료 때는 pimon 이 SIGTERM 처리기에서 이미 복구하고 기록을 지웠으므로 할 일이 없다.
ExecStopPost=/usr/bin/python3 -m pimon --config /etc/pimon/pimon.toml --restore-led
Restart=on-failure
RestartSec=5
# SIGTERM 뒤 LED 복구까지 기다리는 시간. 넘기면 SIGKILL → ExecStopPost 가 복구한다.
TimeoutStopSec=10

# 기록 파일 폴더. pimon.toml 의 [led] state_path 와 맞출 것 (기본 /run/pimon/led.json).
RuntimeDirectory=pimon
RuntimeDirectoryMode=0755
# 반드시 yes. 기본값(no)이면 서비스가 멈출 때마다 — 비정상 종료 뒤 Restart 할 때도 —
# systemd 가 /run/pimon 을 지운다. 그러면 SIGKILL 등으로 죽어 LED 가 none 으로 남은 순간
# "원래 trigger" 기록도 함께 사라지고, 다시 시작한 pimon 은 none 을 원래 값으로 적어
# LED 가 영영 mmc0 로 돌아오지 않는다. 이 기록을 살려 두는 것이 이번 기능의 핵심이다.
# (/run 은 tmpfs 라 재부팅하면 비워지므로, 지난 부팅의 기록이 남을 걱정은 없다.)
RuntimeDirectoryPreserve=yes

# --- 보안: root 로 돌지만 할 수 있는 일을 좁힌다 ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# ProtectSystem=strict 는 / 전체를 읽기 전용으로 만든다 (/dev, /proc, /sys 는 제외).
# RuntimeDirectory 는 자동으로 쓰기 가능하지만, state_path 를 바꾸거나 RuntimeDirectory 를 빼는
# 경우를 위해 적어 둔다. 앞의 "-" 는 경로가 없어도 시작을 막지 않게 한다.
ReadWritePaths=-/run/pimon
# LED 폴더. /sys/class/leds/ACT 는 심볼릭 링크라 (파이 4: /sys/devices/platform/leds/leds/ACT)
# 실제 경로를 적어야 할 수 있다. 파이에서 `readlink -f /sys/class/leds/ACT` 로 확인할 것.
# ProtectKernelTunables 를 켜지 않는 한 /sys 는 원래 쓰기 가능하므로 이 줄은 그때를 위한 것.
ReadWritePaths=-/sys/devices/platform/leds/leds/ACT

# 주의: ProtectKernelTunables=yes 는 /sys 전체를 읽기 전용으로 다시 마운트해 LED 쓰기를 막는다.
# 켜려면 위 ReadWritePaths 의 실제 LED 경로가 정말 열리는지 파이에서 먼저 확인해야 한다
# (LED 를 못 쓰면 pimon 은 로그만 남기고 깜빡임 없이 돈다). 확인 전까지는 켜지 않는다.
#ProtectKernelTunables=yes

[Install]
WantedBy=multi-user.target
