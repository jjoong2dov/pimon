[Unit]
Description=pimon 라즈베리 파이 상태 모니터
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pimon/current
ExecStart=/usr/bin/python3 -m pimon run --config /etc/pimon/pimon.toml
ExecReload=/bin/kill -HUP $MAINPID
# 어떻게 끝났든(강제 종료 포함) LED 를 기록된 원래 상태로 되돌린다
ExecStopPost=/usr/bin/python3 -m pimon restore-led --config /etc/pimon/pimon.toml
Restart=on-failure
RestartSec=5
StateDirectory=pimon

# LED 파일이 root 소유라 root 로 돈다. 대신 root 의 특권(capability)은 모두 버리고,
# /sys 는 LED 폴더만 쓸 수 있게 한다.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=-/sys/devices/platform/leds/leds
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
